{
  "name": "jaffer",
  "productName": "Jaffer",
  "version": "0.3.3",
  "description": "An agentic terminal for macOS with one persistent session and a self-evolving memory.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "dist/main/main.cjs",
  "author": "Jaffer",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && electron .",
    "start": "electron .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "pack": "npm run build && electron-builder --dir",
    "dist:mac": "npm run build && electron-builder --mac",
    "install:mac": "bash scripts/install-mac.sh",
    "daemon": "node dist/daemon/jafferd.cjs",
    "cli": "node dist/cli/jaffer.cjs",
    "gen": "node scripts/gen-shell.mjs",
    "icon": "node scripts/make-icon.mjs",
    "smoke": "JAFFER_SMOKE=1 electron .",
    "screenshots": "JAFFER_SCREENSHOTS=docs/screenshots vitest run --config vitest.e2e.config.ts test/e2e/screenshots.test.ts"
  },
  "dependencies": {
    "@lydell/node-pty": "1.2.0-beta.15",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@preact/signals": "^2.11.3",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "@xterm/addon-clipboard": "^0.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-image": "^0.9.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.56.1",
    "preact": "^10.27.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "ws": "^8.18.0",
    "zod": "^4.6.5"
  }
}
